classDiagram
    direction TB

    class REALISATEUR {
        -int id
        -string nom
        -string prenom
        -date date_naissance
        -string nationalite
        -text biographie
        -string photo_url

        +getId() int
        +setId(int id) void
        +getNom() string
        +setNom(string nom) void
        +getPrenom() string
        +setPrenom(string prenom) void
        +getDateNaissance() date
        +setDateNaissance(date date) void
        +getNationalite() string
        +setNationalite(string nationalite) void
        +getBiographie() string
        +setBiographie(string biographie) void
        +getPhotoUrl() string
        +setPhotoUrl(string url) void
    }

    class FILM {
        -int id
        -string titre
        -string description
        -datetime date_sortie
        -int duree
        -int classification_age
        -string poster_url
        -string video_stream_url
        -int status

        +getId() int
        +setId(int id) void
        +getTitre() string
        +setTitre(string titre) void
        +getDescription() string
        +setDescription(string description) void
        +getDateSortie() datetime
        +setDateSortie(datetime date) void
        +getDuree() int
        +setDuree(int duree) void
        +getClassificationAge() int
        +setClassificationAge(int age) void
        +getPosterUrl() string
        +setPosterUrl(string url) void
        +getVideoStreamUrl() string
        +setVideoStreamUrl(string url) void
        +getStatus() int
        +setStatus(int status) void
    }

    class GENRE {
        -int id
        -string description
        -string nom

        +getId() int
        +setId(int id) void
        +getDescription() string
        +setDescription(string description) void
        +getNom() string
        +setNom(string nom) void

    }

    REALISATEUR "1" --> "0..*" FILM : réalise
    GENRE "1" --> "1..*" FILM : associe